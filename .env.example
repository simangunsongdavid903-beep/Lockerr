# Salin file ini menjadi .env untuk pengembangan lokal.
# Di Railway, isi variabel ini lewat menu Variables. Jangan commit file .env.

NODE_ENV=development
PORT=3000

# PostgreSQL. Di Railway, gunakan variabel DATABASE_URL dari layanan PostgreSQL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_locker
# Isi true jika database memerlukan SSL (misalnya URL publik Railway).
DB_SSL=false

# Daftar asal (origin) yang boleh mengakses API, dipisahkan koma.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Alamat API yang dipakai frontend (dibaca saat build Vite).
VITE_API_URL=http://localhost:3000
